# Aplikasi
APP_NAME="SIEM Salabim"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta
# Wizard tetap terbuka sampai instalasi berhasil dan marker privat ditulis.
APP_INSTALLED=false
INSTALLER_TOKEN_TTL=3600

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL adalah default instalasi baru. Kredensial diisi melalui /install.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=siem_salabim
DB_USERNAME=siem_app
DB_PASSWORD=
DB_SSLMODE=prefer
# Hanya dipakai bila SQLite dipilih secara manual untuk pengembangan lokal.
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL

# Session, cache, dan queue
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
# Harus lebih besar daripada timeout worker update (3600 detik).
DB_QUEUE_RETRY_AFTER=3660
# Gunakan nilai yang sama bila backend queue diganti.
REDIS_QUEUE_RETRY_AFTER=3660
BEANSTALKD_QUEUE_RETRY_AFTER=3660
CACHE_STORE=database

# Email: gunakan MAIL_MAILER=smtp dan isi server SMTP untuk mengirim email.
# Mode log hanya mencatat email ke log selama pengembangan.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Penyimpanan lokal dan aset
FILESYSTEM_DISK=local
# Ekspor SIEM selalu disimpan di disk privat. Untuk produksi, arahkan ke disk
# durable (mis. s3) dan aktifkan encryption-at-rest pada volume/bucket.
SIEM_EXPORT_DISK=local
SIEM_EXPORT_DIRECTORY=siem-exports
# SIEM_EXPORT_TEMP_DIRECTORY=D:\\secure-temp\\siem-exports
SIEM_EXPORT_CHUNK_SIZE=500
SIEM_EXPORT_PURGE_MAX_ROWS=100000
SIEM_EXPORT_QUEUE=exports
SIEM_EXPORT_REQUIRE_ASYNC_QUEUE=true

# Self-update dinonaktifkan secara default. Aktifkan hanya setelah backup penuh
# dan runner deployment/rollback telah disiapkan sesuai panduan operasional.
SIEM_SELF_UPDATE_ENABLED=false
SIEM_UPDATE_BACKUP_CONFIRMED=false
SIEM_UPDATE_QUEUE=updates
SIEM_UPDATE_REFUSE_DIRTY_WORKTREE=true
SIEM_UPDATE_PROCESS_TIMEOUT=900
BROADCAST_CONNECTION=log
VITE_APP_NAME="${APP_NAME}"

# Integrasi awal diisi melalui /install; admin dapat merotasinya di Settings:
# - Host, kredensial, dan indeks OpenSearch.
# - Token bot dan chat tujuan Telegram.
# - Endpoint, API key, model AI, ambang level, batas sampel, dan interval analisis.
# Parameter di bawah hanya untuk pengaturan teknis server yang belum ada di UI.

# OpenSearch: TLS dan beban permintaan
OPENSEARCH_VERIFY_SSL=true
OPENSEARCH_SIZE=100
OPENSEARCH_FETCH_PAGE_DELAY_MS=250
OPENSEARCH_SOURCE_CLUSTER=wazuh-primary
OPENSEARCH_FETCH_OVERLAP_SECONDS=900
OPENSEARCH_RECONCILE_LOOKBACK_DAYS=2
OPENSEARCH_FETCH_INSERT_BATCH_SIZE=100
OPENSEARCH_FETCH_LOCK_SECONDS=3600
# Aktifkan hanya setelah memverifikasi field keyword/doc_values yang unik dan
# selalu terisi pada setiap concrete index di seluruh jendela fetch.
OPENSEARCH_PIT_ENABLED=false
OPENSEARCH_PIT_TIEBREAKER_FIELD=
OPENSEARCH_PIT_KEEP_ALIVE_SECONDS=120

# AI: batas waktu, thinking, dan panjang respons; model mengikuti Settings.
AMANAI_TIMEOUT=90
AMANAI_REASONING_EFFORT=none
AMANAI_MAX_OUTPUT_TOKENS=4096
AMANAI_ALERT_TIMEOUT=60
AMANAI_ALERT_REASONING_EFFORT=none
AMANAI_ALERT_MAX_OUTPUT_TOKENS=2800

# Telegram: koneksi API, timeout, dan retry
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_CONNECT_TIMEOUT=5
TELEGRAM_TIMEOUT=20
TELEGRAM_MAX_ATTEMPTS=3
TELEGRAM_FORCE_IPV4=true
