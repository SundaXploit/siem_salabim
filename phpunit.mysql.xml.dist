<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory="storage/framework/testing/phpunit-mysql-cache"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit"><directory>tests/Unit</directory></testsuite>
        <testsuite name="Feature"><directory>tests/Feature</directory></testsuite>
    </testsuites>
    <source><include><directory>app</directory></include></source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_TIMEZONE" value="Asia/Jakarta"/>
        <env name="APP_KEY" value="01234567890123456789012345678901"/>
        <env name="APP_CIPHER" value="AES-256-GCM"/>
        <env name="SIEM_BLIND_INDEX_KEY" value="12345678901234567890123456789012"/>
        <env name="SIEM_ALLOW_LEGACY_PLAINTEXT" value="true"/>
        <env name="APP_INSTALLED" value="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SIEM_EXPORT_REQUIRE_ASYNC_QUEUE" value="false"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="SIEM_TEST_MYSQL" value="1" force="true"/>
        <env name="SIEM_SQL_TEST_DRIVER" value="mysql"/>
        <env name="SIEM_ACK_TEST_DRIVER" value="mysql"/>
        <env name="SIEM_NOTIFY_TEST_DRIVER" value="mysql"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="siem_mysql_test"/>
        <env name="DB_USERNAME" value="siem_test"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_CHARSET" value="utf8mb4" force="true"/>
        <env name="DB_SSLMODE" value="prefer"/>
    </php>
</phpunit>
